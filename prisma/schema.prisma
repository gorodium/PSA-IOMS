generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  EMPLOYEE
  VIEWER
}

enum ProjectCategory {
  STATISTICAL_OPERATIONS
  CIVIL_REGISTRATION_VITAL_STATISTICS
  PHILIPPINE_IDENTIFICATION_SYSTEM
  ADMINISTRATIVE_ACCOUNTING_REPORTS
}

enum ProjectFrequency {
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AD_HOC
  CUSTOM
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  COMPLETED
  OVERDUE
  DUE_TODAY
  DUE_SOON
  ON_TRACK
  NO_DEADLINE
  INACTIVE
}

enum TaskStatus {
  COMPLETED
  OVERDUE
  DUE_TODAY
  DUE_SOON
  ON_TRACK
  NO_DEADLINE
  INACTIVE
}

enum ActivityType {
  EVENT
  TRAVEL
  VEHICLE
  HOLIDAY
  ROOM
  TRAINING
}

enum VehicleRequestStatus {
  PENDING
  APPROVED
  ASSIGNED
  REJECTED
  CANCELLED
}

enum RoomReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RoomReservationType {
  HALF_DAY
  SINGLE_DAY
  MULTIPLE_DAYS
}

enum HalfDaySlot {
  MORNING
  AFTERNOON
}

enum ConvocationProgramStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

enum ConvocationAssignmentMode {
  FIXED
  CUSTOM
  ASSIGNABLE
  OVERRIDDEN
  MIRRORED
}

enum ChatChannelType {
  GENERAL
  PRIVATE
  SYSTEM
  ADMIN_REQUESTS
  DIRECT
  ADMIN_FEEDBACK
}

enum ChatChannelMemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum ChatMessageType {
  USER_MESSAGE
  SYSTEM_MESSAGE
  REQUEST_NOTIFICATION
  REQUEST_STATUS_UPDATE
}

enum LocationType {
  OFFICE
  OUTSIDE_OFFICE
  CUSTOM
  UNKNOWN
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  CUSTOM
  MULTIPLE_MATCHES
}

model User {
  id                       String               @id @default(cuid())
  name                     String
  username                 String               @unique
  email                    String?              @unique
  photoUrl                 String?
  mustChangePassword       Boolean              @default(true)
  passwordHash             String
  role                     UserRole             @default(VIEWER)
  personnelId              String?              @unique
  personnel                Personnel?           @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  employeeId               String?
  section                  String?
  isActive                 Boolean              @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdProjects          Project[]            @relation("ProjectCreatedBy")
  updatedProjects          Project[]            @relation("ProjectUpdatedBy")
  projectPermissions       ProjectPermission[]
  assignedPermissions      ProjectPermission[]  @relation("ProjectPermissionAssignedBy")
  resetTokens              PasswordResetToken[]
  remarks                  ProjectRemark[]
  auditLogs                AuditLog[]
  createdVehicleRequests   VehicleRequest[]     @relation("VehicleRequestsCreatedBy")
  reviewedVehicleRequests  VehicleRequest[]     @relation("VehicleRequestsReviewedBy")
  createdRoomReservations  RoomReservation[]    @relation("RoomReservationsCreatedBy")
  approvedRoomReservations RoomReservation[]    @relation("RoomReservationsApprovedBy")
  rejectedRoomReservations RoomReservation[]    @relation("RoomReservationsRejectedBy")
  generatedConvocations    ConvocationProgram[] @relation("ConvocationGeneratedBy")
  finalizedConvocations    ConvocationProgram[] @relation("ConvocationFinalizedBy")
  createdChatChannels      ChatChannel[]        @relation("ChatChannelCreatedBy")
  chatChannelMemberships   ChatChannelMember[]
  sentChatMessages         ChatMessage[]        @relation("ChatMessageSender")
  chatMessageReads         ChatMessageRead[]
  createdCustomEmojis      CustomEmoji[]        @relation("CustomEmojiCreatedBy")
  chatReactions            ChatReaction[]       @relation("UserChatReactions")
  createdPdfTemplates      PdfTemplate[]        @relation("PdfTemplateCreatedBy")
  createdNetworkMaps       NetworkMap[]         @relation("NetworkMapCreatedBy")

  @@index([role])
  @@index([isActive])
}

model Personnel {
  id                       String                         @id @default(cuid())
  slug                     String                         @unique
  employeeNo               String?                        @unique
  fullName                 String
  position                 String
  section                  String
  email                    String?                        @unique
  contactNo                String?
  isActive                 Boolean                        @default(true)
  archiveReason            String?
  archiveDate              DateTime?
  photoUrl                 String?
  locationStatus           String                         @default("office") // "office" or "on_travel"
  travelDetails            String?
  travelDestination        String?
  travelStartDate          DateTime?
  travelEndDate            DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  users                    User[]
  projectAssignments       ProjectPersonnel[]
  assignedTasks            ProjectTask[]
  activities               CalendarActivity[]
  involvedActivities       CalendarActivity[]             @relation("ActivityInvolvedPersonnel")
  specialOrderInvolvements SpecialOrderPerson[]
  vehicleRequests          VehicleRequest[]               @relation("VehicleRequestRequester")
  vehicleRequestPassengers VehicleRequestPassenger[]      @relation("VehicleRequestPassengerPersonnel")
  roomReservations         RoomReservation[]              @relation("RoomReservationRequester")
  convocationGroupMembers  ConvocationGroupMember[]
  convocationAssignments   ConvocationProgramItem[]       @relation("ConvocationItemAssignee")
  convocationHistory       ConvocationAssignmentHistory[]
  employeeSeats            EmployeeSeat[]
  networkDevices           NetworkDevice[]

  @@index([section])
  @@index([isActive])
}

model Project {
  id                         String              @id @default(cuid())
  name                       String
  slug                       String              @unique @default(cuid())
  code                       String?             @unique
  description                String?
  category                   ProjectCategory
  subcategory                String?
  section                    String?
  year                       Int
  frequency                  ProjectFrequency
  customFrequency            String?
  priority                   ProjectPriority     @default(MEDIUM)
  workloadWeight             Float               @default(1)
  estimatedMandays           Float               @default(0)
  status                     ProjectStatus       @default(ON_TRACK)
  uiLayout                   String              @default("BALANCED")
  showDescription            Boolean             @default(true)
  showOperationWorkload      Boolean             @default(true)
  showDeadlineSubmission     Boolean             @default(true)
  showDateSubmitted          Boolean             @default(true)
  showTotalSamplesDocuments  Boolean             @default(true)
  showResponseRate           Boolean             @default(true)
  operationWorkloadLabel     String              @default("Project/Operation/Workload")
  deadlineSubmissionLabel    String              @default("Deadline of Submission")
  dateSubmittedLabel         String              @default("Date Submitted")
  totalSamplesDocumentsLabel String              @default("Total Sample/Documents")
  responseRateLabel          String              @default("Response Rate")
  customTaskColumns          Json?
  canvasLayout               Json?
  isActive                   Boolean             @default(true)
  createdById                String?
  updatedById                String?
  createdBy                  User?               @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                  User?               @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  personnel                  ProjectPersonnel[]
  permissions                ProjectPermission[]
  cycles                     ProjectCycle[]
  remarks                    ProjectRemark[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([status])
  @@index([category])
  @@index([year])
  @@index([isActive])
}

model ProjectPermission {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  canView      Boolean  @default(true)
  canEdit      Boolean  @default(false)
  canSubmit    Boolean  @default(false)
  canApprove   Boolean  @default(false)
  canManage    Boolean  @default(false)
  assignedById String?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("ProjectPermissionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model ProjectPersonnel {
  id            String    @id @default(cuid())
  projectId     String
  personnelId   String
  roleInProject String
  isFocalPerson Boolean   @default(false)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personnel     Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, personnelId])
  @@index([personnelId])
  @@index([isFocalPerson])
}

model ProjectCycle {
  id                    String          @id @default(cuid())
  projectId             String
  cycleName             String
  month                 Int?
  quarter               Int?
  year                  Int
  startDate             DateTime?
  deadline              DateTime?
  dateSubmitted         DateTime?
  progress              Int             @default(0)
  responseRate          Float?
  totalSamplesDocuments Int?
  status                ProjectStatus   @default(ON_TRACK)
  remarks               String?
  isActive              Boolean         @default(true)
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                 ProjectTask[]
  projectRemarks        ProjectRemark[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([projectId, cycleName, year])
  @@index([projectId])
  @@index([status])
  @@index([deadline])
}

model ProjectTask {
  id                    String          @id @default(cuid())
  projectCycleId        String
  taskName              String
  assignedPersonnelId   String?
  startDate             DateTime?
  deadline              DateTime?
  dateSubmitted         DateTime?
  progress              Int             @default(0)
  status                TaskStatus      @default(ON_TRACK)
  responseRate          Float?
  totalSamplesDocuments Int?
  customValues          Json?
  manualStatusOverride  String?
  remarks               String?
  isSubtitle            Boolean         @default(false)
  order                 Int             @default(0)
  isActive              Boolean         @default(true)
  projectCycle          ProjectCycle    @relation(fields: [projectCycleId], references: [id], onDelete: Cascade)
  assignedPersonnel     Personnel?      @relation(fields: [assignedPersonnelId], references: [id], onDelete: SetNull)
  projectRemarks        ProjectRemark[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([projectCycleId, taskName])
  @@index([projectCycleId])
  @@index([assignedPersonnelId])
  @@index([status])
  @@index([deadline])
}

model ProjectRemark {
  id             String        @id @default(cuid())
  projectId      String?
  projectCycleId String?
  taskId         String?
  authorId       String
  remarkText     String
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCycle   ProjectCycle? @relation(fields: [projectCycleId], references: [id], onDelete: Cascade)
  task           ProjectTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId])
  @@index([projectCycleId])
  @@index([taskId])
  @@index([authorId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  oldValueJson Json?
  newValueJson Json?
  ipAddress    String?
  userAgent    String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model CanvasTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarActivity {
  id                  String               @id @default(cuid())
  type                ActivityType
  additionalTypes     ActivityType[]       @default([])
  title               String
  soNumber            String?
  soFileUrl           String?
  description         String?
  startDate           DateTime
  endDate             DateTime?
  location            String?
  personnelId         String?
  vehicleName         String?
  personnel           Personnel?           @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  involvedPersonnel   Personnel[]          @relation("ActivityInvolvedPersonnel")
  vehicleRequests     VehicleRequest[]
  roomReservations    RoomReservation[]
  convocationPrograms ConvocationProgram[]
  specialOrders       SpecialOrder[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([type])
  @@index([startDate])
}

model SpecialOrder {
  id                 String             @id @default(cuid())
  referenceNo        String?
  soNumber           String?
  assignedDate       DateTime?
  activityDate       DateTime?
  activityDateString String?
  purpose            String?
  destination        String?
  remarks            String?
  status             String?
  locationType       LocationType       @default(UNKNOWN)
  
  calendarActivityId String?
  calendarActivity   CalendarActivity?  @relation(fields: [calendarActivityId], references: [id], onDelete: SetNull)
  
  people             SpecialOrderPerson[]
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([referenceNo, soNumber, purpose])
  @@index([activityDate])
  @@index([locationType])
}

model SpecialOrderPerson {
  id                 String          @id @default(cuid())
  specialOrderId     String
  originalName       String
  normalizedName     String
  personnelId        String?
  matchStatus        MatchStatus     @default(UNMATCHED)
  customLabel        String?
  isTravelTagged     Boolean         @default(false)
  
  specialOrder       SpecialOrder    @relation(fields: [specialOrderId], references: [id], onDelete: Cascade)
  personnel          Personnel?      @relation(fields: [personnelId], references: [id], onDelete: SetNull)

  @@index([specialOrderId])
  @@index([personnelId])
  @@index([matchStatus])
}

model Vehicle {
  id          String           @id @default(cuid())
  name        String
  plateNumber String?          @unique
  description String?
  isActive    Boolean          @default(true)
  requests    VehicleRequest[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive])
}

model VehicleRequest {
  id                   String                    @id @default(cuid())
  requesterPersonnelId String
  requestedByUserId    String?
  travelDate           DateTime
  departureAt          DateTime?
  expectedReturnAt     DateTime?
  purpose              String
  destination          String
  status               VehicleRequestStatus      @default(PENDING)
  assignedVehicleId    String?
  soNumber             String?
  soFileUrl            String?
  adminNotes           String?
  rejectionReason      String?
  reviewedById         String?
  calendarActivityId   String?
  requester            Personnel                 @relation("VehicleRequestRequester", fields: [requesterPersonnelId], references: [id], onDelete: Restrict)
  requestedBy          User?                     @relation("VehicleRequestsCreatedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?                     @relation("VehicleRequestsReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedVehicle      Vehicle?                  @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  calendarActivity     CalendarActivity?         @relation(fields: [calendarActivityId], references: [id], onDelete: SetNull)
  passengers           VehicleRequestPassenger[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([requesterPersonnelId])
  @@index([requestedByUserId])
  @@index([assignedVehicleId])
  @@index([travelDate])
  @@index([status])
}

model VehicleRequestPassenger {
  id          String         @id @default(cuid())
  requestId   String
  personnelId String
  request     VehicleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  personnel   Personnel      @relation("VehicleRequestPassengerPersonnel", fields: [personnelId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  @@unique([requestId, personnelId])
  @@index([personnelId])
}

model Room {
  id                String            @id @default(cuid())
  name              String            @unique
  isAvailable       Boolean           @default(true)
  unavailableReason String?
  isActive          Boolean           @default(true)
  reservations      RoomReservation[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([isAvailable])
  @@index([isActive])
}

model RoomReservation {
  id                   String                @id @default(cuid())
  roomId               String
  requesterPersonnelId String
  requestedByUserId    String?
  reservationType      RoomReservationType
  startDate            DateTime
  endDate              DateTime
  halfDaySlot          HalfDaySlot?
  purpose              String
  remarks              String?
  status               RoomReservationStatus @default(PENDING)
  approvedById         String?
  approvedAt           DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  rejectionReason      String?
  cancelledAt          DateTime?
  calendarActivityId   String?
  room                 Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  requester            Personnel             @relation("RoomReservationRequester", fields: [requesterPersonnelId], references: [id], onDelete: Restrict)
  requestedBy          User?                 @relation("RoomReservationsCreatedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy           User?                 @relation("RoomReservationsApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy           User?                 @relation("RoomReservationsRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  calendarActivity     CalendarActivity?     @relation(fields: [calendarActivityId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([roomId])
  @@index([requesterPersonnelId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ConvocationGroup {
  id        String                         @id @default(cuid())
  name      String                         @unique
  sortOrder Int
  isActive  Boolean                        @default(true)
  members   ConvocationGroupMember[]
  programs  ConvocationProgram[]
  history   ConvocationAssignmentHistory[]
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model ConvocationGroupMember {
  id                String           @id @default(cuid())
  groupId           String
  personnelId       String
  isTechnicalPerson Boolean          @default(false)
  isGroupLead       Boolean          @default(false)
  isAvailable       Boolean          @default(true)
  isActive          Boolean          @default(true)
  group             ConvocationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personnel         Personnel        @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([groupId, personnelId])
  @@index([personnelId])
  @@index([isAvailable])
  @@index([isActive])
}

model ConvocationTemplateItem {
  id              String                    @id @default(cuid())
  itemKey         String                    @unique
  itemLabel       String
  itemOrder       Int
  defaultMode     ConvocationAssignmentMode
  fixedTextValue  String?
  isEnabled       Boolean                   @default(true)
  rotationKey     String?
  mirrorOfItemKey String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([itemOrder])
  @@index([isEnabled])
}

model ConvocationProgram {
  id                 String                         @id @default(cuid())
  convocationDate    DateTime                       @unique
  groupId            String
  status             ConvocationProgramStatus       @default(DRAFT)
  generatedById      String?
  finalizedById      String?
  finalizedAt        DateTime?
  printedAt          DateTime?
  notes              String?
  calendarActivityId String?
  group              ConvocationGroup               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  generatedBy        User?                          @relation("ConvocationGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  finalizedBy        User?                          @relation("ConvocationFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  calendarActivity   CalendarActivity?              @relation(fields: [calendarActivityId], references: [id], onDelete: SetNull)
  items              ConvocationProgramItem[]
  history            ConvocationAssignmentHistory[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([groupId])
  @@index([status])
  @@index([convocationDate])
}

model ConvocationProgramItem {
  id                   String                    @id @default(cuid())
  programId            String
  itemKey              String
  itemLabel            String
  itemOrder            Int
  assignmentMode       ConvocationAssignmentMode
  assignedPersonnelId  String?
  suggestedPersonnelId String?
  fixedTextValue       String?
  isEnabled            Boolean                   @default(true)
  rotationKey          String?
  mirrorOfItemKey      String?
  countInRotation      Boolean                   @default(false)
  overrideReason       String?
  program              ConvocationProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  assignedPersonnel    Personnel?                @relation("ConvocationItemAssignee", fields: [assignedPersonnelId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([programId, itemKey])
  @@index([assignedPersonnelId])
  @@index([itemOrder])
}

model ConvocationAssignmentHistory {
  id                String             @id @default(cuid())
  programId         String
  groupId           String
  personnelId       String
  itemKey           String
  rotationKey       String
  convocationDate   DateTime
  wasOverride       Boolean            @default(false)
  countedInRotation Boolean            @default(true)
  program           ConvocationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  group             ConvocationGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  personnel         Personnel          @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@unique([programId, rotationKey])
  @@index([groupId, rotationKey])
  @@index([personnelId])
  @@index([convocationDate])
}

model ChatChannel {
  id          String              @id @default(cuid())
  name        String
  description String?
  channelType ChatChannelType     @default(GENERAL)
  createdById String?
  photoUrl    String?
  createdBy   User?               @relation("ChatChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isActive    Boolean             @default(true)
  members     ChatChannelMember[]
  messages    ChatMessage[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([name, channelType])
  @@index([channelType])
  @@index([isActive])
}

model ChatChannelMember {
  id        String                @id @default(cuid())
  channelId String
  userId    String
  role      ChatChannelMemberRole @default(MEMBER)
  isActive  Boolean               @default(true)
  joinedAt  DateTime              @default(now())
  channel   ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([isActive])
}

model ChatMessage {
  id                String            @id @default(cuid())
  channelId         String
  senderUserId      String?
  messageType       ChatMessageType   @default(USER_MESSAGE)
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  metadataJson      Json?
  deletedAt         DateTime?
  channel           ChatChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender            User?             @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  reads             ChatMessageRead[]
  attachments       ChatAttachment[]
  reactions         ChatReaction[]    @relation("ChatMessageReactions")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([channelId, createdAt])
  @@index([senderUserId])
  @@index([messageType])
  @@index([relatedEntityType, relatedEntityId])
  @@index([deletedAt])
}

model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([messageId])
  @@index([mimeType])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([readAt])
}

model CustomEmoji {
  id          String         @id @default(cuid())
  name        String         @unique
  imageUrl    String
  createdById String?
  createdBy   User?          @relation("CustomEmojiCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  reactions   ChatReaction[]

  @@index([name])
}

model ChatReaction {
  id            String       @id @default(cuid())
  messageId     String
  userId        String
  emoji         String?
  customEmojiId String?
  createdAt     DateTime     @default(now())
  message       ChatMessage  @relation("ChatMessageReactions", fields: [messageId], references: [id], onDelete: Cascade)
  user          User         @relation("UserChatReactions", fields: [userId], references: [id], onDelete: Cascade)
  customEmoji   CustomEmoji? @relation(fields: [customEmojiId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji, customEmojiId])
  @@index([messageId])
  @@index([customEmojiId])
}

model PdfTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  templateFeature String   @default("GENERAL")
  fileName        String
  fileUrl         String
  pageCount       Int      @default(1)
  fieldMap        Json?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdById     String?
  createdBy       User?    @relation("PdfTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([templateFeature])
  @@index([createdById])
}

// ── ICT Infrastructure Map ────────────────────────────────────────────────────

enum MapFurnitureType {
  DESK
  COMPUTER_DESK
  CABINET
  TABLE
  CHAIR
  SERVER_RACK
  PRINTER_STATION
  RECEPTION
  WALL
  PARTITION
  OTHER
}

enum NetworkDeviceType {
  DESKTOP
  LAPTOP
  PRINTER
  ACCESS_POINT
  SWITCH
  ROUTER
  FIREWALL
  SERVER
  IP_PHONE
  CCTV
  OTHER
}

enum NetworkDeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  UNKNOWN
}

enum NetworkConnectionType {
  LAN
  WIFI
  FIBER
  USB
  BLUETOOTH
  OTHER
}

model NetworkMap {
  id          String        @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  createdById String?
  createdBy   User?         @relation("NetworkMapCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  furniture   MapFurniture[]
  seats       EmployeeSeat[]
  devices     NetworkDevice[]
  connections NetworkConnection[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model MapFurniture {
  id            String          @id @default(cuid())
  mapId         String
  furnitureCode String
  furnitureName String
  type          MapFurnitureType @default(DESK)
  xPercent      Float           @default(50)
  yPercent      Float           @default(50)
  widthPercent  Float           @default(5)
  heightPercent Float           @default(3)
  rotation      Float           @default(0)
  section       String?
  room          String?
  label         String?
  remarks       String?
  map           NetworkMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  seats         EmployeeSeat[]
  devices       NetworkDevice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([mapId])
}

model EmployeeSeat {
  id          String        @id @default(cuid())
  mapId       String
  furnitureId String?
  personnelId String?
  seatCode    String
  xPercent    Float         @default(50)
  yPercent    Float         @default(50)
  section     String?
  room        String?
  remarks     String?
  map         NetworkMap    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  furniture   MapFurniture? @relation(fields: [furnitureId], references: [id], onDelete: SetNull)
  personnel   Personnel?    @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  devices     NetworkDevice[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([mapId])
  @@index([personnelId])
}

model NetworkDevice {
  id             String              @id @default(cuid())
  mapId          String
  furnitureId    String?
  employeeSeatId String?
  personnelId    String?
  deviceCode     String
  deviceName     String
  type           NetworkDeviceType   @default(DESKTOP)
  status         NetworkDeviceStatus @default(UNKNOWN)
  hostname       String?
  ipAddress      String?
  macAddress     String?
  section        String?
  room           String?
  xPercent       Float               @default(50)
  yPercent       Float               @default(50)
  lastSeenAt     DateTime?
  remarks        String?
  map            NetworkMap          @relation(fields: [mapId], references: [id], onDelete: Cascade)
  furniture      MapFurniture?       @relation(fields: [furnitureId], references: [id], onDelete: SetNull)
  employeeSeat   EmployeeSeat?       @relation(fields: [employeeSeatId], references: [id], onDelete: SetNull)
  personnel      Personnel?          @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  sourceConnections NetworkConnection[] @relation("ConnectionSource")
  targetConnections NetworkConnection[] @relation("ConnectionTarget")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([mapId])
  @@index([personnelId])
  @@index([status])
  @@index([type])
}

model NetworkConnection {
  id             String                @id @default(cuid())
  mapId          String
  sourceDeviceId String
  targetDeviceId String
  connectionType NetworkConnectionType @default(LAN)
  sourcePort     String?
  targetPort     String?
  cableLabel     String?
  isVerified     Boolean               @default(false)
  remarks        String?
  map            NetworkMap            @relation(fields: [mapId], references: [id], onDelete: Cascade)
  sourceDevice   NetworkDevice         @relation("ConnectionSource", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  targetDevice   NetworkDevice         @relation("ConnectionTarget", fields: [targetDeviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([mapId])
  @@index([sourceDeviceId])
  @@index([targetDeviceId])
}
